# SnapList AI Environment Configuration
# Copy this file to .env or set these in Render Dashboard -> Environment

# 1. (Recommended) Hugging Face User Access Token (Free)
# Enables direct serverless open-weight inference for Llama 3.2, Mistral 7B, and Qwen 2.5
# Get your free token at: https://huggingface.co/settings/tokens
HF_TOKEN=

# 2. (Optional) Custom Self-Hosted / Local Node Endpoint
# If you run Ollama or vLLM locally or on a private VPS (e.g., http://localhost:11434/api/generate)
OLLAMA_ENDPOINT=

# 3. Port configuration (Default 3001 locally; Render sets PORT=10000 automatically)
PORT=3001
NODE_ENV=development
